<UserControl x:Class="AlenkaAssistant.Views.PurchaseRequestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlenkaAssistant.Views"
        xmlns:converters="clr-namespace:AlenkaAssistant.Views.Converters"
        mc:Ignorable="d"
        Background="#F5F5F5"
        d:DesignHeight="1080" 
        d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:DoctorNameToDisplayItemConverter x:Key="DoctorNameConverter"/>
        <converters:AssistantNameToDisplayItemConverter x:Key="AssistantNameConverter"/>
        <converters:TreatmentTypeToDisplayItemConverter x:Key="TreatmentTypeConverter"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="Formulir Perawatan Gigi" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,30" 
                       Foreground="#333333"/>

            <!-- UID TextBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="No. RM" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <TextBox Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" 
                         Padding="12,10" 
                         FontSize="12"
                         Background="White"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"/>
            </StackPanel>

            <!-- General Treatment Description TextBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tindakan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <TextBox Text="{Binding TreatmentDescription, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" 
                         Padding="12,10" 
                         FontSize="12"
                         Background="White"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Treatment Type ComboBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tipe Tindakan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding TreatmentTypes}" 
                          SelectedItem="{Binding SelectedTreatmentType, Converter={StaticResource TreatmentTypeConverter}}" 
                          Height="40" 
                          Padding="12,10" 
                          FontSize="12"
                          Background="White"
                          BorderThickness="1"
						  BorderBrush="#CCCCCC"/>
			</StackPanel>

			<!-- Assistant List Section -->
			<StackPanel Margin="0,0,0,20">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Nama Asisten" 
							   FontSize="14" 
							   FontWeight="SemiBold"
							   Foreground="#555555"
							   VerticalAlignment="Center"/>
					<Button Command="{Binding AddAssistantCommand}" 
							Content="Tambah" 
							Width="80" 
							Height="30" 
							Margin="10,0,0,0"
							Background="#2196F3"
							Foreground="White"
							FontSize="11"
							FontWeight="SemiBold"
							Cursor="Hand" Click="Button_Click"/>
				</StackPanel>

				<!-- Items Control for Assistant List -->
				<ItemsControl ItemsSource="{Binding AssistantsList}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
								<ComboBox ItemsSource="{Binding DataContext.AssistantNamesForList, RelativeSource={RelativeSource AncestorType=UserControl}}" 
										  SelectedItem="{Binding SelectedAssistant, Converter={StaticResource AssistantNameConverter}, UpdateSourceTrigger=PropertyChanged}" 
										  Height="35" 
										  Width="180"
										  Padding="10,8" 
										  FontSize="12"
										  Background="White"
										  BorderThickness="1"
										  BorderBrush="#CCCCCC"
										  Foreground="#555555"
										  VerticalAlignment="Center"/>
								<TextBox Text="{Binding CustomAssistantName, UpdateSourceTrigger=PropertyChanged}" 
										 Height="35" 
										 Width="180"
										 Padding="10,8" 
										 FontSize="12"
										 Background="White"
										 BorderThickness="1"
										 BorderBrush="#CCCCCC"
										 Margin="10,0,0,0"
										 Foreground="#555555"
										 VerticalAlignment="Center"
										 Visibility="{Binding ShowCustomInput, Converter={StaticResource BooleanToVisibilityConverter}}"/>
								<Button Command="{Binding DataContext.RemoveAssistantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
										CommandParameter="{Binding}" 
										Content="Hapus" 
										Width="70" 
										Height="35" 
										Margin="10,0,0,0"
										Background="#f44336"
										Foreground="White"
										FontSize="11"
										FontWeight="SemiBold"
										Cursor="Hand"
										VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- Doctor Name ComboBox -->
			<StackPanel Margin="0,0,0,20">
				<TextBlock Text="Nama Dokter"
						   FontSize="14"
						   FontWeight="SemiBold"
						   Margin="0,0,0,8"
						   Foreground="#555555"/>
				<ComboBox ItemsSource="{Binding DoctorNames}"
						  SelectedItem="{Binding SelectedDoctor, Converter={StaticResource DoctorNameConverter}}"
						  Height="40"
						  Padding="12,10"
						  FontSize="12"
						  Background="White"
						  BorderThickness="1"
						  BorderBrush="#CCCCCC"/>
				<!-- Custom Doctor Name TextBox -->
				<TextBox Text="{Binding CustomDoctorName, UpdateSourceTrigger=PropertyChanged}" 
						 Height="40" 
						 Padding="12,10" 
						 FontSize="12"
						 Background="White"
						 BorderThickness="1"
						 BorderBrush="#CCCCCC"
						 Margin="0,8,0,0"
						 Visibility="{Binding ShowCustomDoctor, Converter={StaticResource BooleanToVisibilityConverter}}"
						 Foreground="#555555"/>
			</StackPanel>

            <!-- Date Time Picker -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tanggal dan Jam Perawatan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <DatePicker SelectedDate="{Binding SelectedDate}" 
                                Height="40" 
                                Padding="12,10" 
                                FontSize="12"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Width="200"
                                VerticalAlignment="Center"/>
                    <TextBlock Text="Jam" 
                               FontSize="12" 
                               Margin="20,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"/>
                    <TextBox Text="{Binding SelectedTime, UpdateSourceTrigger=PropertyChanged}" 
                             Height="40" 
                             Width="100" 
                             Padding="12,10" 
                             FontSize="12"
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Cost List Section -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Daftar Biaya Perawatan" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding AddCostCommand}" 
                            Content="Tambah" 
                            Width="80" 
                            Height="30" 
                            Margin="10,0,0,0"
                            Background="#2196F3"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Items Control for Cost List -->
                <ItemsControl ItemsSource="{Binding CostsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Text="{Binding TreatmentDesc, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="300"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="100"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Margin="10,0,0,0"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"/>
                                <Button Command="{Binding DataContext.RemoveCostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Content="Hapus" 
                                        Width="70" 
                                        Height="35" 
                                        Margin="10,0,0,0"
                                        Background="#f44336"
                                        Foreground="White"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Total Cost Display -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0" Background="#E8F5E9">
                    <TextBlock Text="Total Biaya: Rp " 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2E7D32"
                               VerticalAlignment="Center"
                               Margin="10,8,0,8"/>
                    <TextBlock Text="{Binding TotalCost, StringFormat=N0}" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2E7D32"
                               VerticalAlignment="Center"
                               Margin="0,8,10,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Margin="0,0,0,20" 
                       Foreground="#4CAF50" 
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                <Button Command="{Binding SaveToGoogleSheetsCommand}" 
                        Content="Simpan ke Google Sheet" 
                        Width="150" 
                        Height="40" 
                        Margin="0,0,10,0"
                        Background="#1976D2"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                <Button Command="{Binding SubmitCommand}" 
                        Content="Simpan" 
                        Width="100" 
                        Height="40" 
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                <Button Command="{Binding CancelCommand}" 
                        Content="Batal" 
                        Width="100" 
                        Height="40"
                        Background="#f44336"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
