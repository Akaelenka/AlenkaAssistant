<UserControl x:Class="AlenkaAssistant.Views.PurchaseRequestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlenkaAssistant.Views"
        mc:Ignorable="d"
        Background="#F5F5F5"
        d:DesignHeight="1080" 
        d:DesignWidth="600">
    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="Formulir Perawatan Gigi" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,30" 
                       Foreground="#333333"/>

            <!-- UID TextBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="No. RM" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <TextBox Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" 
                         Padding="12,10" 
                         FontSize="12"
                         Background="White"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"/>
            </StackPanel>

            <!-- General Treatment Description TextBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tindakan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <TextBox Text="{Binding TreatmentDescription, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" 
                         Padding="12,10" 
                         FontSize="12"
                         Background="White"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Assistant Name ComboBox -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Nama Asisten" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding AssistantNames}" 
                          SelectedItem="{Binding SelectedAssistant}" 
                          Height="40" 
                          Padding="12,10" 
                          FontSize="12"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC"/>
            </StackPanel>

			<!-- Doctor Name ComboBox -->
			<StackPanel Margin="0,0,0,20">
				<TextBlock Text="Nama Dokter"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
				<ComboBox ItemsSource="{Binding DoctorNames}"
                          SelectedItem="{Binding SelectedDoctor}"
                          Height="40"
                          Padding="12,10"
                          FontSize="12"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC"/>
			</StackPanel>

            <!-- Date Time Picker -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tanggal dan Jam Perawatan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <DatePicker SelectedDate="{Binding SelectedDate}" 
                                Height="40" 
                                Padding="12,10" 
                                FontSize="12"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Width="200"
                                VerticalAlignment="Center"/>
                    <TextBlock Text="Time:" 
                               FontSize="12" 
                               Margin="20,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"/>
                    <TextBox Text="{Binding SelectedTime, UpdateSourceTrigger=PropertyChanged}" 
                             Height="40" 
                             Width="100" 
                             Padding="12,10" 
                             FontSize="12"
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Margin="0,0,0,20" 
                       Foreground="#4CAF50" 
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                <Button Command="{Binding SubmitCommand}" 
                        Content="Simpan" 
                        Width="100" 
                        Height="40" 
                        Margin="0,0,10,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
                <Button Command="{Binding CancelCommand}" 
                        Content="Batal" 
                        Width="100" 
                        Height="40"
                        Background="#f44336"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
