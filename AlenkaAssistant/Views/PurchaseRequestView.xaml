<UserControl x:Class="AlenkaAssistant.Views.PurchaseRequestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlenkaAssistant.Views"
        xmlns:converters="clr-namespace:AlenkaAssistant.Views.Converters"
        mc:Ignorable="d"
        Background="#F5F5F5"
        d:DesignHeight="1080" 
        d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:TreatmentTypeToDisplayItemConverter x:Key="TreatmentTypeConverter"/>
        <converters:StringPassThroughConverter x:Key="StringPassThroughConverter"/>
        <converters:MoneyFormatConverter x:Key="MoneyFormatConverter"/>
        <converters:StatusMessageColorConverter x:Key="StatusMessageColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
            <StackPanel Margin="30" VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="Formulir Perawatan Gigi" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,30" 
                       Foreground="#333333"/>

            <!-- UID TextBox -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="No. RM" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding AddPatientCommand}" 
                            Content="Tambah Pasien" 
                            Width="120" 
                            Height="30" 
                            Margin="10,0,0,0"
                            Background="#FF9800"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="UidTextBox"
                         Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" 
                         Padding="12,10" 
                         FontSize="12"
                         Background="White"
                         BorderThickness="1"
                         BorderBrush="#CCCCCC"/>

                <!-- Patient Name Display Area -->
                <StackPanel Margin="0,8,0,0" x:Name="PatientDisplayPanel">
                    <!-- Loading Indicator -->
                    <TextBlock x:Name="PatientLoadingIndicator"
                               Text="🔄 Loading..."
                               FontSize="12"
                               Foreground="#0066CC"
                               Visibility="Collapsed"
                               Margin="0,0,0,4"/>

                    <!-- Patient Name (Success - Green) -->
                    <TextBlock x:Name="PatientNameDisplay"
                               Text="{Binding PatientName}"
                               FontSize="12"
                               Foreground="#228B22"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Margin="0,0,0,4"/>

                    <!-- Error/Warning Message (Red/Orange) -->
                    <TextBlock x:Name="PatientErrorDisplay"
                               Text="{Binding PatientLookupMessage}"
                               FontSize="11"
                               Foreground="#D9534F"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

			<!-- Assistant List Section -->
			<StackPanel Margin="0,0,0,20">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Text="Nama Asisten" 
							   FontSize="14" 
							   FontWeight="SemiBold"
							   Foreground="#555555"
							   VerticalAlignment="Center"/>
					<Button Command="{Binding AddAssistantCommand}" 
							Content="Tambah" 
							Width="80" 
							Height="30" 
							Margin="10,0,0,0"
							Background="#2196F3"
							Foreground="White"
							FontSize="11"
							FontWeight="SemiBold"
							Cursor="Hand" Click="Button_Click"/>
				</StackPanel>

				<!-- Items Control for Assistant List -->
				<ItemsControl ItemsSource="{Binding AssistantsList}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
								<ComboBox ItemsSource="{Binding DataContext.AssistantNamesForList, RelativeSource={RelativeSource AncestorType=UserControl}}" 
										  SelectedItem="{Binding SelectedAssistantName, Converter={StaticResource StringPassThroughConverter}, UpdateSourceTrigger=PropertyChanged}" 
										  Height="35" 
										  Width="180"
										  Padding="10,8" 
										  FontSize="12"
										  Background="White"
										  BorderThickness="1"
										  BorderBrush="#CCCCCC"
										  Foreground="#555555"
										  VerticalAlignment="Center"/>
								<TextBox Text="{Binding CustomAssistantName, UpdateSourceTrigger=PropertyChanged}" 
										 Height="35" 
										 Width="180"
										 Padding="10,8" 
										 FontSize="12"
										 Background="White"
										 BorderThickness="1"
										 BorderBrush="#CCCCCC"
										 Margin="10,0,0,0"
										 Foreground="#555555"
										 VerticalAlignment="Center"
										 Visibility="{Binding ShowCustomInput, Converter={StaticResource BoolToVisibilityConverter}}"/>
								<Button Command="{Binding DataContext.RemoveAssistantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
										CommandParameter="{Binding}" 
										Content="Hapus" 
										Width="70" 
										Height="35" 
										Margin="10,0,0,0"
										Background="#f44336"
										Foreground="White"
										FontSize="11"
										FontWeight="SemiBold"
										Cursor="Hand"
										VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- Doctor Name ComboBox -->
			<StackPanel Margin="0,0,0,20">
				<TextBlock Text="Nama Dokter"
						   FontSize="14"
						   FontWeight="SemiBold"
						   Margin="0,0,0,8"
						   Foreground="#555555"/>
				<ComboBox ItemsSource="{Binding DoctorNames}"
						  SelectedItem="{Binding SelectedDoctorName}"
						  Height="40"
						  Padding="12,10"
						  FontSize="12"
						  Background="White"
						  BorderThickness="1"
						  BorderBrush="#CCCCCC"/>
				<!-- Custom Doctor Name TextBox -->
				<TextBox Text="{Binding CustomDoctorName, UpdateSourceTrigger=PropertyChanged}" 
						 Height="40" 
						 Padding="12,10" 
						 FontSize="12"
						 Background="White"
						 BorderThickness="1"
						 BorderBrush="#CCCCCC"
						 Margin="0,8,0,0"
						 Visibility="{Binding ShowCustomDoctor, Converter={StaticResource BoolToVisibilityConverter}}"
						 Foreground="#555555"/>
			</StackPanel>

            <!-- Date Time Picker -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tanggal dan Jam Perawatan" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"
                           Foreground="#555555"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <DatePicker SelectedDate="{Binding SelectedDate}" 
                                Height="40" 
                                Padding="12,10" 
                                FontSize="12"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC"
                                Width="200"
                                VerticalAlignment="Center"/>
                    <TextBlock Text="Jam" 
                               FontSize="12" 
                               Margin="20,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"/>
                    <TextBox Text="{Binding SelectedTime, UpdateSourceTrigger=PropertyChanged}" 
                             Height="40" 
                             Width="100" 
                             Padding="12,10" 
                             FontSize="12"
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Cost List Section -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Daftar Biaya Perawatan" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding AddCostCommand}" 
                            Content="Tambah" 
                            Width="80" 
                            Height="30" 
                            Margin="10,0,0,0"
                            Background="#2196F3"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Column Headers for Cost List -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
                    <TextBlock Text="Tindakan" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="220"
                               Margin="0,0,0,0"/>
                    <TextBlock Text="Tipe" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="110"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="Biaya" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="85"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="Qty" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="50"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="Diskon" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="70"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Width="60"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Items Control for Cost List -->
                <ItemsControl ItemsSource="{Binding CostsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- Treatment Description -->
                                <TextBox Text="{Binding TreatmentDesc, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="220"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"/>

                                <!-- Treatment Type -->
                                <ComboBox ItemsSource="{Binding DataContext.TreatmentTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding TreatmentType, Converter={StaticResource TreatmentTypeConverter}, UpdateSourceTrigger=PropertyChanged}"
                                          Height="35"
                                          Width="110"
                                          Padding="10,8"
                                          FontSize="12"
                                          Background="White"
                                          BorderThickness="1"
                                          BorderBrush="#CCCCCC"
                                          Margin="10,0,0,0"
                                          Foreground="#555555"
                                          VerticalAlignment="Center"/>

                                <!-- Cost with Money Format -->
                                <TextBox Text="{Binding Cost, Converter={StaticResource MoneyFormatConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="85"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Margin="10,0,0,0"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"
                                         TextAlignment="Right"/>

                                <!-- Item Count -->
                                <TextBox Text="{Binding ItemCount, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="50"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Margin="10,0,0,0"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"
                                         TextAlignment="Center"/>

                                <!-- Discount with Money Format -->
                                <TextBox Text="{Binding Discount, Converter={StaticResource MoneyFormatConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="35" 
                                         Width="70"
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="1"
                                         BorderBrush="#CCCCCC"
                                         Margin="10,0,0,0"
                                         Foreground="#555555"
                                         VerticalAlignment="Center"
                                         TextAlignment="Right"/>

                                <!-- Delete Button -->
                                <Button Command="{Binding DataContext.RemoveCostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Content="Hapus" 
                                        Width="60" 
                                        Height="35" 
                                        Margin="10,0,0,0"
                                        Background="#f44336"
                                        Foreground="White"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Total Cost Display -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0" Background="#E8F5E9">
                    <TextBlock Text="Total Biaya: Rp " 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2E7D32"
                               VerticalAlignment="Center"
                               Margin="10,8,0,8"/>
                    <TextBlock Text="{Binding TotalCost, StringFormat=N0}" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="#2E7D32"
                               VerticalAlignment="Center"
                               Margin="0,8,10,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Margin="0,0,0,20" 
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusMessageColorConverter}}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="500"
                       MinHeight="30"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Button Bar at Bottom -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="30,15,30,15" HorizontalAlignment="Right" Background="#F5F5F5">
            <Button Command="{Binding PrintCommand}" 
                    Content="Print" 
                    Width="100" 
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#FF9800"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Print invoice preview"/>
            <Button Command="{Binding SaveToGoogleSheetsCommand}" 
                    Content="Submit" 
                    Width="100" 
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#1976D2"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Save data to Google Sheets"/>
            <Button Command="{Binding SaveLocalCommand}" 
                    Content="Simpan" 
                    Width="100" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Save data locally on this computer"/>
            <Button Command="{Binding CancelCommand}" 
                    Content="Batal" 
                    Width="100" 
                    Height="40"
                    Background="#f44336"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Cancel and clear form"/>
        </StackPanel>
    </Grid>
</UserControl>
