<Window x:Class="AlenkaAssistant.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" 
        Title="Alenka Invoice - Print Preview"
        Width="1000"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FlowDocument Page Viewer for preview -->
        <FlowDocumentPageViewer x:Name="DocumentViewer" Grid.Row="0" Background="#F5F5F5" Zoom="100"/>

        <!-- Button Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20" Background="White">
            <Button Name="PrintButton" Click="PrintButton_Click" 
                    Content="Print" 
                    Width="100" 
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#1976D2"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
            <Button Name="CancelButton" Click="CancelButton_Click" 
                    Content="Cancel" 
                    Width="100" 
                    Height="40"
                    Background="#f44336"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
